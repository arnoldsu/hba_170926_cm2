#!/bin/bash -l
#PBS -S /bin/bash
#PBS -P p66
#PBS -W umask=002
#PBS -r y
#PBS -l storage=gdata/hh5+gdata/fs38+gdata/oi10+gdata/rr3+gdata/xp65+gdata/al33+gdata/rt52+gdata/zz93+scratch/nf33+gdata/ct11+gdata/p66+gdata/p73
#PBS -l wd
#PBS -q normal
#PBS -l walltime=04:00:00
#PBS -l mem=64GB
#PBS -l ncpus=8
#PBS -l jobfs=64GB
#PBS -N hba_cm2_native
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from hba_170926_cm2}"
module purge
module load pbs
module use /g/data/xp65/public/modules
module load conda/analysis3-26.01

output=${OUTPUT:-ACCESS_CM2_HBA_VD2001_native_25S25N_Wm2.nc}
args=(--output "$output")
if [[ -n "${NMONTHS:-}" ]]; then args+=(--nmonths "$NMONTHS"); fi
python calculate_heat_budget_cm2.py "${args[@]}"
